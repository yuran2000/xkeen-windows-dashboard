# Персональные секреты (НЕ коммитить никогда!)
config_local.py
runtime_settings.json

# Python venv и кэш
.venv/
__pycache__/
*.pyc
*.pyo

# Бэкапы и логи
backups/
*.bak-*
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini
# Windows reserved-name артефакт: git-bash ssh c "UserKnownHostsFile=NUL" создаёт
# реальный файл ./NUL в рабочей папке (на Windows-ssh.exe NUL — это null-устройство).
# Игнорируем, чтобы он не попал в коммит при git add -A.
NUL

# Сертификаты, ключи (на случай если кто-то положит)
*.pem
*.key
*.crt
.ssh/
ssh/

# Локальные эксперименты
*.local.*

# Runtime state daemon'ов (v1.7.21+)
xkeen_toast_daemon.state.json
xkeen_toast_daemon.lock

# Manual restore docs (создаются юзером локально)
HOW_TO_RESTORE.md

# Portable build — публикуем только build.bat + config.ini.template
# (чтобы клонировавший репо мог собрать exe), артефакты сборки и личные
# wrapper'ы — локально.
portable/build/
portable/dist/
portable/*.spec
portable/update-portable.bat

# Локальные dev-инструменты (локальные средства предпросмотра)
# Используется для генерации обезличенных скриншотов docs/screenshot*.png.
.*/
!.github/
!.github/**
_screenshot_helper.py
_github_screenshot_helper.py
_filter_*_callback.py
_wg_review*.diff

# Реестр выданных WireGuard-доступов (имена клиентов, публичные ключи)
wg_clients.json
wg_clients.json.bak
wg_clients.json.tmp

+        f"rm -f {path}; "
+        f"crontab -l 2>/dev/null | grep -vF '{path}' | crontab -; "
+        f"for T in nat mangle; do iptables -t $T -S PREROUTING 2>/dev/null | grep -- '-i {kernel}' | sed 's|^-A |-D |' | while read r; do iptables -t $T $r 2>/dev/null; done; done; "
+        f"iptables -t nat -S INPUT 2>/dev/null | grep -- '-i {kernel}' | sed 's|^-A |-D |' | while read r; do iptables -t nat $r 2>/dev/null; done; "
+        f"[ -n \"$SUBNET\" ] && iptables -t nat -S POSTROUTING 2>/dev/null | grep -F \"$SUBNET\" | grep MASQUERADE | sed 's|^-A |-D |' | while read r; do iptables -t nat $r 2>/dev/null; done; "

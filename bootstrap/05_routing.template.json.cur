// Watchdog template v12 (2026-05-27): подменяются 9 placeholder'ов через watchdog.sh:
//   __DEFAULT_TAG__       — основной outbound для всего обычного трафика
//   __BLOCK_RULE_BLOCK__  — block-правило с пользовательскими доменами (BLOCK_DOMAINS) — ПЕРВЫМ по приоритету
//   __DIRECT_RULE_BLOCK__ — direct-правило с пользовательскими доменами (DIRECT_DOMAINS)
//   __AI_RULE_BLOCK__     — AI-sticky правило (или пусто если AI_DOMAINS пуст)
//   __YT_RULE_BLOCK__     — YouTube-sticky правило по доменам (или пусто если YT_DOMAINS пуст)
//   __YT_RULE_GEOIP__     — YouTube-sticky правило по IP-диапазонам (geoip:NAME из geoip.dat).
//                           Нужно для IP-only приложений типа Telegram Desktop, которые
//                           коннектятся напрямую к датацентрам минуя DNS — доменные
//                           правила их не ловят.
//   FOREIGN_RULE_BLOCK / FOREIGN_RULE_GEOIP — канал «Заблокированные в РФ» (Meta/Telegram/
//                           Twitter/Discord) по доменам и по geoip; через FOREIGN_TAG (загран-выход).
//   __IPV6_RULE_BLOCK__   — канал «🌐 Через IPv6» (IPv6-only сайты, напр. ntc.party): IPV6_DOMAINS
//                           через IPV6_TAG (узел с IPv6-egress + routeOnly:false). Перед catch-all.
// Все списки (BLOCK_DOMAINS, DIRECT_DOMAINS, AI_DOMAINS, AI_TAG, YT_DOMAINS, YT_TAG, YT_GEOIP_CATEGORIES, FOREIGN_*, IPV6_*) редактируются через дашборд /xkeen.
{
  "routing": {
    "rules": [
      { "inboundTag": ["redirect","tproxy"], "outboundTag": "block", "type": "field",
        "network": "udp", "port": "135, 137, 138, 139" },
      { "inboundTag": ["redirect","tproxy"], "outboundTag": "block", "type": "field",
        "network": "udp", "port": "443" },
      { "inboundTag": ["redirect","tproxy"], "outboundTag": "direct", "type": "field",
        "ip": [
          "94.156.237.35",
          "95.85.233.195",
          "178.215.238.35",
          "144.31.14.34",
          "130.49.190.39",
          "81.177.214.11",
          "193.202.11.18",
          "37.18.15.174",
          "78.159.246.239",
          "81.94.148.168",
          "78.159.250.11"
        ] },
__BLOCK_RULE_BLOCK__
__DIRECT_RULE_BLOCK__
      { "inboundTag": ["redirect","tproxy"], "outboundTag": "direct", "type": "field",
        "domain": [
          "regexp:^([\\w\\-\\.]+\\.)ru$",
          "regexp:^([\\w\\-\\.]+\\.)su$",
          "regexp:^([\\w\\-\\.]+\\.)xn--p1ai$",
          "ext:geosite_v2fly.dat:category-gov-ru",
          "ext:geosite_v2fly.dat:private",
          "ext:geosite_v2fly.dat:yandex",
          "ext:geosite_v2fly.dat:steam",
          "ext:geosite_v2fly.dat:vk"
        ] },
      { "inboundTag": ["redirect","tproxy"], "outboundTag": "direct", "type": "field",
        "protocol": ["bittorrent"] },
__AI_RULE_BLOCK__
__YT_RULE_BLOCK__
__YT_RULE_GEOIP__
__FOREIGN_RULE_BLOCK__
__FOREIGN_RULE_GEOIP__
__IPV6_RULE_BLOCK__
{ "inboundTag": ["socks-local"], "outboundTag": "vless-reality", "type": "field" },
{ "inboundTag": ["redirect","tproxy"], "outboundTag": "__DEFAULT_TAG__", "type": "field" }
]
  }
}
